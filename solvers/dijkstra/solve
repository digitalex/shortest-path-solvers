#!/usr/bin/env python3
import sys
import collections
import heapq

def main():
    if len(sys.argv) < 2:
        print("Usage: solve <input_file>")
        sys.exit(1)

    filename = sys.argv[1]

    num_nodes = 0
    adj = collections.defaultdict(list)

    with open(filename, 'r') as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('c'):
                continue
            parts = line.split()
            if not parts:
                continue
            if parts[0] == 'p':
                num_nodes = int(parts[2])
            elif parts[0] == 'a':
                u, v, w = int(parts[1]), int(parts[2]), int(parts[3])
                adj[u].append((v, w))

    if num_nodes == 0:
        print("Error: number of nodes not found")
        sys.exit(1)

    pq = [(0, 1)]
    dist = {1: 0}
    visited = set()

    while pq:
        d, u = heapq.heappop(pq)

        if u in visited:
            continue
        visited.add(u)

        if u == num_nodes:
            print(d)
            return

        for v, w in adj[u]:
            if v not in visited:
                new_d = d + w
                if new_d < dist.get(v, float('inf')):
                    dist[v] = new_d
                    heapq.heappush(pq, (new_d, v))

    print("Unreachable")

if __name__ == '__main__':
    main()
