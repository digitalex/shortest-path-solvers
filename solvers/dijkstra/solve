#!/usr/bin/env python3
import sys
import os
import collections
import heapq

sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import dimacs

def main():
    if len(sys.argv) < 2:
        print("Usage: solve <input_file>")
        sys.exit(1)

    filename = sys.argv[1]

    try:
        num_nodes, edges = dimacs.load_dimacs(filename)
    except ValueError as e:
        print(f"Error: {e}")
        sys.exit(1)

    adj = collections.defaultdict(list)
    for u, v, w in edges.tolist():
        adj[u].append((v, w))

    pq = [(0, 1)]
    dist = {1: 0}
    visited = set()

    while pq:
        d, u = heapq.heappop(pq)

        if u in visited:
            continue
        visited.add(u)

        if u == num_nodes:
            print(d)
            return

        for v, w in adj[u]:
            if v not in visited:
                new_d = d + w
                if new_d < dist.get(v, float('inf')):
                    dist[v] = new_d
                    heapq.heappush(pq, (new_d, v))

    print("Unreachable")

if __name__ == '__main__':
    main()
