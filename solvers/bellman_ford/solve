#!/usr/bin/env python3
import sys
import os

sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import dimacs

def main():
    if len(sys.argv) < 2:
        print("Usage: solve <input_file>")
        sys.exit(1)

    filename = sys.argv[1]

    try:
        num_nodes, edges_array = dimacs.load_dimacs(filename)
        edges = edges_array.tolist()
    except ValueError as e:
        print(f"Error: {e}")
        sys.exit(1)

    # Bellman-Ford from node 1 to num_nodes
    dist = {i: float('inf') for i in range(1, num_nodes + 1)}
    dist[1] = 0

    for _ in range(num_nodes - 1):
        updated = False
        for u, v, w in edges:
            if dist[u] + w < dist[v]:
                dist[v] = dist[u] + w
                updated = True
        if not updated:
            break

    # Assuming no negative cycles
    ans = dist[num_nodes]
    if ans == float('inf'):
        print("Unreachable")
    else:
        print(ans)

if __name__ == '__main__':
    main()
