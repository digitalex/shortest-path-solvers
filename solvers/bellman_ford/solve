#!/usr/bin/env python3
import sys

def main():
    if len(sys.argv) < 2:
        print("Usage: solve <input_file>")
        sys.exit(1)

    filename = sys.argv[1]

    num_nodes = 0
    edges = []

    with open(filename, 'r') as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('c'):
                continue
            parts = line.split()
            if not parts:
                continue
            if parts[0] == 'p':
                # p sp n m
                num_nodes = int(parts[2])
            elif parts[0] == 'a':
                # a u v w
                u, v, w = int(parts[1]), int(parts[2]), int(parts[3])
                edges.append((u, v, w))

    if num_nodes == 0:
        print("Error: number of nodes not found")
        sys.exit(1)

    # Bellman-Ford from node 1 to num_nodes
    dist = {i: float('inf') for i in range(1, num_nodes + 1)}
    dist[1] = 0

    for _ in range(num_nodes - 1):
        updated = False
        for u, v, w in edges:
            if dist[u] + w < dist[v]:
                dist[v] = dist[u] + w
                updated = True
        if not updated:
            break

    # Assuming no negative cycles
    ans = dist[num_nodes]
    if ans == float('inf'):
        print("Unreachable")
    else:
        print(ans)

if __name__ == '__main__':
    main()
