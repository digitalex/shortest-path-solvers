#!/usr/bin/env python3
import sys
import os
from collections import deque

sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import dimacs

def main():
    if len(sys.argv) < 2:
        print("Usage: solve <input_file>")
        sys.exit(1)

    filename = sys.argv[1]

    try:
        num_nodes, edges_array = dimacs.load_dimacs(filename)
        edges = edges_array.tolist()
    except ValueError as e:
        print(f"Error: {e}")
        sys.exit(1)

    dist = [float('inf')] * (num_nodes + 1)
    dist[1] = 0

    adj = [[] for _ in range(num_nodes + 1)]
    for u, v, w in edges:
        adj[u].append((v, w))

    q = deque([1])
    in_q = [False] * (num_nodes + 1)
    in_q[1] = True

    while q:
        u = q.popleft()
        in_q[u] = False

        d_u = dist[u]
        for v, w in adj[u]:
            if d_u + w < dist[v]:
                dist[v] = d_u + w
                if not in_q[v]:
                    q.append(v)
                    in_q[v] = True

    ans = dist[num_nodes]
    if ans == float('inf'):
        print("Unreachable")
    else:
        print(ans)

if __name__ == '__main__':
    main()
